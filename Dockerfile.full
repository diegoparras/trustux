# Dockerfile.full — Trustux con el Tier 3 nativo (recuperación de clave por diccionario/fuerza
# bruta). Suma John the Ripper **jumbo** (CPU), hashcat (+ pocl para OpenCL en CPU si no hay GPU),
# qpdf, 7-Zip, unar y bkcrack (ZipCrypto por texto conocido). La imagen base (Dockerfile) queda
# liviana; esta es opt-in para quien quiere el cracking. El app detecta los binarios por PATH/env.
#
# IMPORTANTE: el paquete `john` de Debian es la edición CORE (solo crypt(3)/NT-LM): NO trae los
# extractores *2john ni los formatos office/pdf/zip/rar. Por eso John se compila del fuente (jumbo),
# igual que bkcrack. Los extractores quedan en /opt/john/run (JOHN_RUN).
FROM node:22-bookworm-slim

WORKDIR /app

# Herramientas de recuperación (OSS) + toolchain para compilar John jumbo y bkcrack.
# pocl = OpenCL en CPU para hashcat sin GPU. perl/python3 = extractores pdf2john.pl / office2john.py.
RUN apt-get update && apt-get install -y --no-install-recommends \
      qpdf p7zip-full unar \
      hashcat pocl-opencl-icd \
      perl python3 \
      git cmake g++ build-essential ca-certificates \
      libssl-dev zlib1g-dev yasm pkg-config libgmp-dev libpcap-dev libbz2-dev \
    && rm -rf /var/lib/apt/lists/*

# John the Ripper **jumbo** — trae los formatos office/pdf/zip/rar y los extractores *2john
# (zip2john, rar2john en run/ como binarios; pdf2john.pl, office2john.py como scripts).
RUN git clone --depth 1 https://github.com/openwall/john /opt/john \
    && cd /opt/john/src \
    && ./configure \
    && make -s -j"$(nproc)" \
    && rm -rf /opt/john/.git

# bkcrack (ataque de texto conocido sobre ZipCrypto) — se compila del fuente. El binario cambia de
# ubicación entre versiones (build/ raíz vs build/src/cli/), así que se localiza con find.
RUN git clone --depth 1 https://github.com/kimci86/bkcrack /tmp/bkcrack \
    && cmake -S /tmp/bkcrack -B /tmp/bkcrack/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/bkcrack/build \
    && cp "$(find /tmp/bkcrack/build -name bkcrack -type f -executable | head -1)" /usr/local/bin/bkcrack \
    && rm -rf /tmp/bkcrack

# Deps de Node (producción).
COPY package.json package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund

# Código del motor + servidor + UI + trust store + módulo goodunluck.
COPY firma-core ./firma-core
COPY unlock-core ./unlock-core
COPY server ./server
COPY client ./client
COPY public ./public
COPY trust ./trust
COPY config ./config

# John jumbo vive en /opt/john/run: el binario `john` y los extractores. JOHN_BIN/JOHN_RUN dejan
# que el motor lo encuentre (JOHN_RUN activa el fallback .pl/.py de pdf2john/office2john).
ENV JOHN_BIN=/opt/john/run/john
ENV JOHN_RUN=/opt/john/run
ENV PATH="/opt/john/run:${PATH}"
ENV PORT=8095
EXPOSE 8095
# Salud: /api/me responde siempre 200 (no expone datos sensibles).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8095)+'/api/me').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.js"]
