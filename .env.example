# Trustux — configuración del standalone. Copiá a .env y ajustá.

# Puerto del servidor.
PORT=8095

# --- SSO opcional con Lockatus (suite Escriba) ---
# local    = sin login, single-user (default; no rompe nada).
# federado = los usuarios entran con Lockatus (OIDC). Requiere registrar la app en Lockatus.
AUTH_MODE=local

# Solo si AUTH_MODE=federado:
LOCKATUS_ISSUER=http://localhost:8081
CLIENT_ID=trustux
REDIRECT_URI=http://localhost:8095/callback
# Clave para firmar la cookie de sesión local. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRUSTUX_SECRET=cambiar-en-produccion
